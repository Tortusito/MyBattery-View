<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MyBatteryView</AssemblyName>
    <RootNamespace>MyBatteryView</RootNamespace>
    <Product>MyBattery-View</Product>
    <Authors>Wyforce</Authors>
    <Company>Wyforce</Company>
    <Description>Monitor ultraligero en segundo plano para ver en tiempo real el porcentaje de batería de tus dispositivos Bluetooth en Windows.</Description>
    <RepositoryUrl>https://github.com/Tortusito/MyBattery-View</RepositoryUrl>
    <Version>1.0.0</Version>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

</Project>
